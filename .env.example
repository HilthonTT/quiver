# Copy to `.env` to configure `quiver` (and docker compose).
# Precedence: command-line flags > environment variables > .env > defaults.

# Network
QUIVER_HOST=127.0.0.1
QUIVER_HTTP_PORT=6900
QUIVER_GRPC_PORT=6901
# QUIVER_DISABLE_HTTP=true
# QUIVER_DISABLE_GRPC=true

# Storage: file (WAL + snapshots) | rocksdb (build with --features rocksdb) | memory
QUIVER_DATA_DIR=./quiver-data
QUIVER_STORAGE=file
# QUIVER_FSYNC=true

# Authentication (any combination; no keys = auth disabled)
# QUIVER_KEYS_FILE=./keys.json
# QUIVER_API_KEY=change-me-readwrite
# QUIVER_READONLY_API_KEY=change-me-readonly

# Snapshots (backups)
# QUIVER_SNAPSHOT_DIR=./quiver-data/snapshots
QUIVER_SNAPSHOT_INTERVAL=0
QUIVER_SNAPSHOT_KEEP=5

# Logging
RUST_LOG=info

# TUI (quiver-tui)
# QUIVER_URL=http://localhost:6900
# QUIVER_EMBEDDING_URL=http://localhost:11434/v1/embeddings
# QUIVER_EMBEDDING_MODEL=nomic-embed-text
